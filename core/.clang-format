---
# Based on Project Readiness and Coding Guidelines (Readiness.md)
# Encoding: Strict 7-bit ASCII | Line Endings: LF | Target: clang-format 19+
BasedOnStyle: Google
Language: Cpp
Standard: c++20
LineEnding: LF
InsertNewlineAtEOF: true

# --- Indentation and Tabs ---
# Uses tabs for structural indentation and spaces for mid-line alignment.
# For pure 4-space (no tabs), set UseTab: Never.
# For Linus Torvalds 8-char tabs, change 4 -> 8 and -4 -> -8 below.
IndentWidth: 4
TabWidth: 4
UseTab: ForIndentation
ContinuationIndentWidth: 4
AccessModifierOffset: -4
IndentCaseLabels: true
NamespaceIndentation: None
FixNamespaceComments: true

# --- Braces and Control Structures ---
# Use 'Allman' for ANSI brace style; use 'Attach' for K&R / Google style.
BreakBeforeBraces: Allman
KeepEmptyLines:
  AtEndOfFile: false
  AtStartOfBlock: false
  AtStartOfFile: false

# --- Line and Spacing Management ---
MaxEmptyLinesToKeep: 1
ColumnLimit: 100
ReflowComments: false
BreakStringLiterals: false
SortUsingDeclarations: LexicographicNumeric

# --- Includes and Header Grouping ---
SortIncludes: CaseInsensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: "^<.*>"
    Priority: 1
  - Regex: ".*"
    Priority: 2

# --- Pointers and References ---
PointerAlignment: Left
ReferenceAlignment: Left

# --- Alignment and Spacing ---
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignEscapedNewlines: Right
AlignOperands: Align
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0

# --- Functions and Arguments ---
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
BinPackArguments: false
BinPackParameters: false
AllowAllParametersOfDeclarationOnNextLine: true
BreakTemplateDeclarations: Yes

# --- Specific Formatting Rules ---
SpaceAfterCStyleCast: false
SpaceAfterLogicalNot: false
SpaceAfterTemplateKeyword: true
SpaceBeforeAssignmentOperators: true
SpaceBeforeCpp11BracedList: true
SpaceBeforeCtorInitializerColon: true
SpaceBeforeInheritanceColon: true
SpaceBeforeParens: ControlStatements
SpaceBeforeRangeBasedForLoopColon: true
SpacesBeforeTrailingComments: 1
SpacesInAngles: Never
SpacesInParens: Never
SpacesInSquareBrackets: false
...
