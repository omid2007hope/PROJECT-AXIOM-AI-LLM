---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'input'>, 'type'>;
---

<input type="checkbox" role="switch" class="toggle" {...Astro.props} />

<style lang="scss">
  .toggle {
    position: relative;
    flex: none;
    width: 2.5rem;
    height: 1.5rem;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--background-sunken);
    appearance: none;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;

    &::before {
      content: '';
      position: absolute;
      inset: 3px auto 3px 3px;
      aspect-ratio: 1;
      border-radius: 50%;
      background: var(--text-color-tertiary);
      transition:
        translate 0.35s cubic-bezier(0.16, 1, 0.3, 1),
        background-color 0.2s ease;
    }

    &:hover::before {
      background: var(--text-color-secondary);
    }

    &:checked {
      border-color: var(--primary-line);
      background: var(--primary-tint);

      &::before {
        translate: 1rem;
        background: var(--primary-increased-contrast);
      }
    }

    &:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    &:focus {
      outline: none;
    }
    &:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }
  }
</style>
