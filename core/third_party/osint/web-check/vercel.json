{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    }
  ],
  "functions": {
    "api/trackers.js": {
      "maxDuration": 45,
      "includeFiles": "node_modules/@ghostery/trackerdb/dist/trackerdb.engine"
    },
    "api/*.js": {
      "maxDuration": 45
    }
  },
  "env": {
    "PLATFORM": "vercel",
    "CI": "false"
  },
  "build": {
    "env": {
      "PLATFORM": "vercel"
    }
  }
}
